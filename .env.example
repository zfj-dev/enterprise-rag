# 复制为 .env 并按需修改
# ===== 运行模式 =====
USE_REAL=false            # true=真实组件(false=demo/测试)
# ===== 数据库 =====
DATABASE_URL=sqlite:///./rag.db       # 真实: postgresql+psycopg://rag:rag@localhost:5432/rag_db
VECTOR_STORE=inmemory                 # inmemory / pgvector
# ===== 嵌入 / 重排 =====
# 四种跑法，用 *_PROVIDER 切换：
#   fake         词袋/词重叠（演示与测试，数字没有意义）
#   bge          本地 GPU（需 torch + sentence-transformers）
#   api          自建推理节点（要自己有 GPU 机器；走 X-Inference-Token）
#   siliconflow  托管 —— **无 GPU 也能跑真实检索**（OpenAI / Cohere 兼容，走 Bearer）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_PROVIDER=fake               # fake / bge / api / siliconflow
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_PROVIDER=fake                # fake / bge / api / siliconflow
# 走 siliconflow（或任何 OpenAI 兼容的托管服务）时，把上面两个模型换成：
#   EMBEDDING_MODEL=BAAI/bge-m3            （1024 维，与默认 EMBEDDING_DIM 一致）
#   RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 并补上 key（要接别家再加 *_API_BASE，默认站点是 SiliconFlow）：
# EMBEDDING_API_KEY=
# RERANK_API_KEY=
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# RERANK_API_BASE=https://api.siliconflow.cn/v1
# 重排不可达时默认**降级为 RRF 原顺序**（不打断回答）。跑评测时建议置 true：
# 那样重排挂掉会直接报错、报告写「未跑」，而不是把 RRF 顺序的数字说成「重排已跑」。
# RERANK_STRICT=false
# ===== 云端 LLM（真实模式，需 Key）=====
LLM_PROVIDER=fake                     # fake / deepseek / siliconflow / openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# ===== 鉴权 =====
SECRET_KEY=change-me
# HuggingFace 镜像（国内用 https://hf-mirror.com）。走**配置**而不是环境变量，
# 这样 .env 一处配置就同时对服务端与评测进程生效。
HF_ENDPOINT=
# ===== 检索/分块 =====
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
MIN_RELEVANCE=0.4
CHUNK_PARENT_SIZE=512
CHUNK_CHILD_SIZE=128
