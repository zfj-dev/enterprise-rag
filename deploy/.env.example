# 生产 .env 模板 —— 复制为 deploy/.env 并填真值(勿提交 .env)
# 各字段含义见 docker-compose.prod.yml。真密钥只放 .env / run_cloud.ps1,不要进 git。
SECRET_KEY=change-me-strong-0123456789abcdef0123456789
POSTGRES_PASSWORD=change-me-pg-password

# 云端 LLM(生成;提问片段出网,已接受)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 私有 GPU 推理节点(经 SSH 隧道落到编排机 host.docker.internal:9000)
EMBEDDING_API_BASE=http://host.docker.internal:9000
EMBEDDING_API_KEY=
RERANK_API_KEY=

# 反代域名:留空 = LAN HTTP;填域名(如 rag.example.com)则 Caddy 自动 HTTPS
CADDY_DOMAIN=
