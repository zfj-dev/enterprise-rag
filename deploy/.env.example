# 生产 .env 模板 —— 复制为 deploy/.env 并填真值(勿提交 .env)
# 各字段含义见 docker-compose.prod.yml。真密钥只放 .env / run_cloud.ps1,不要进 git。
#
# ⚠️ SECRET_KEY 是**签 JWT 的密钥**，拿它就能伪造任意用户（含 admin）的令牌：
#    - 必须真随机，别用这里的占位值 —— 服务启动时会拒绝仓库里出现过的公开默认值；
#    - 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
#    - demo 编排(deploy/docker-compose.yml) 同样读本文件里的 SECRET_KEY。
SECRET_KEY=change-me-strong-0123456789abcdef0123456789
POSTGRES_PASSWORD=change-me-pg-password

# 管理员 admin 的初始口令。**生产编排(USE_REAL=true)首次建号时必须填** —— 留空会直接
# 拒绝启动：真实模式不接受默认口令，也不会把生成的口令打进容器日志（那是换个地方泄漏）。
# 演示编排留空则回落**公开的** admin123 并在启动日志里提醒。
# 该值只在该用户还不存在时生效，之后改密走 POST /api/v1/auth/change-password。
ADMIN_PASSWORD=

# 对外暴露时**务必**显式列出前端来源（留空 = `*`，任意站点都能调本 API）。
CORS_ORIGINS=

# 额度硬拦：对外给用户用就该设上限，否则一个号能无限烧服务端的 Key。
# QUOTA_LIMIT<=0 = 不设上限（启动会告警，不会静默）。
QUOTA_ENABLED=false
QUOTA_WINDOW=day
QUOTA_LIMIT=0

# 云端 LLM(生成;提问片段出网,已接受)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 私有 GPU 推理节点(经 SSH 隧道落到编排机 host.docker.internal:9000)
EMBEDDING_API_BASE=http://host.docker.internal:9000
EMBEDDING_API_KEY=
RERANK_API_KEY=

# 反代域名:留空 = LAN HTTP;填域名(如 rag.example.com)则 Caddy 自动 HTTPS
CADDY_DOMAIN=
